import dropbox
from getpass import getpass
token = getpass("Enter your Dropbox access token: ")
dbx = dropbox.Dropbox(token)
print("Dropbox connection object created successfully!")
  
with open("myfile.txt", "rb") as f:
    result = dbx.files_upload(f.read(), "/myfile.txt")
print("Upload successful!")
print("Uploaded file:", result.path_display)

# Download the file from Dropbox
metadata, response = dbx.files_download("/myfile.txt")
# Save the downloaded content locally
with open("downloaded_myfile.txt", "wb") as f:
    f.write(response.content)
print("File downloaded successfully!")
# Display the downloaded content
with open("downloaded_myfile.txt", "r") as f:
    print(f.read())

