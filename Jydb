from pymongo import MongoClient
from getpass import getpass
uri = getpass("Enter your MongoDB Atlas connection string: ")
client = MongoClient(uri, serverSelectionTimeoutMS=10000)
client.admin.command("ping")
print("Connected to MongoDB Atlas successfully!")

db = client["CollegeDB"]
students = db["students"]
print("Database:", db.name)
print("Collection:", students.name)

records = [
    {"roll_no": 101, "name": "Arun", "department": "IT", "mark": 85},
    {"roll_no": 102, "name": "Priya", "department": "CSE", "mark": 92},
    {"roll_no": 103, "name": "Kavin", "department": "IT", "mark": 78}
]
result = students.insert_many(records)
print("Inserted records:", len(result.inserted_ids))

for student in students.find():
    print(student)

result = students.update_one(
    {"roll_no": 101},
    {"$set": {"mark": 90}}
)
print("Records updated:", result.modified_count)

result = students.delete_one({"roll_no": 103})
print("Records deleted:", result.deleted_count)

for student in students.find():
    print(student)

client.close()
print("Connection closed.")
